{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unity Analytics Allocations Override Rules API",
    "version": "v1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Override Rules",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Override Rules",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://analytics.services.api.unity.com/v1/projects/:projectId/environments/:environmentId/rules",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Returns all override rules for the environment. Rules target specific player segments with configuration overrides."
        },
        {
          "info": {
            "name": "Create Override Rule",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://analytics.services.api.unity.com/v1/projects/:projectId/environments/:environmentId/rules",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new override rule targeting a specific player segment with custom configuration values."
        },
        {
          "info": {
            "name": "Update Override Rule",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://analytics.services.api.unity.com/v1/projects/:projectId/environments/:environmentId/rules/:ruleId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "ruleId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Updates an existing override rule's conditions or settings."
        },
        {
          "info": {
            "name": "Delete Override Rule",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://analytics.services.api.unity.com/v1/projects/:projectId/environments/:environmentId/rules/:ruleId",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "ruleId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Deletes a targeting override rule."
        }
      ]
    }
  ],
  "bundled": true
}