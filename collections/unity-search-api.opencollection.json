{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unity Analytics Allocations Search API",
    "version": "v1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Query Lobbies",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://analytics.services.api.unity.com/v1/lobbies/query",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Searches for available lobbies using filter and sort criteria. Only returns public lobbies."
        }
      ]
    }
  ],
  "bundled": true
}