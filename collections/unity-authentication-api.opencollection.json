{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unity Analytics Allocations Authentication API",
    "version": "v1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sign In Anonymously",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://analytics.services.api.unity.com/v1/authentication/anonymous",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Signs in a player anonymously and returns an access token. Creates a new player account if the session ID does not match any existing player."
        },
        {
          "info": {
            "name": "Sign In With Username and Password",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://analytics.services.api.unity.com/v1/authentication/usernamepassword/sign-in",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticates a player using their username and password credentials."
        },
        {
          "info": {
            "name": "Sign Up With Username and Password",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://analytics.services.api.unity.com/v1/authentication/usernamepassword/sign-up",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Creates a new player account with username and password credentials."
        },
        {
          "info": {
            "name": "Sign In With External Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://analytics.services.api.unity.com/v1/authentication/external-token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticates a player using a token from an external identity provider such as Google, Apple, Steam, Facebook, or a custom provider."
        },
        {
          "info": {
            "name": "Refresh Authentication Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://analytics.services.api.unity.com/v1/token/refresh",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchanges a refresh token for a new access token without requiring the player to re-authenticate."
        }
      ]
    }
  ],
  "bundled": true
}