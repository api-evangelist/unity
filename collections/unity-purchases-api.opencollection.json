{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unity Analytics Allocations Purchases API",
    "version": "v1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Purchases",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Make Virtual Purchase",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://analytics.services.api.unity.com/v2/projects/:projectId/environments/:environmentId/players/:playerId/purchases/virtual",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "playerId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Processes a virtual purchase using the player's in-game currency or items."
        }
      ]
    }
  ],
  "bundled": true
}