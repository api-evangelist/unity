{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unity Analytics Allocations Inventory API",
    "version": "v1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Inventory",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Player Inventory",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://analytics.services.api.unity.com/v2/projects/:projectId/environments/:environmentId/players/:playerId/inventory",
            "params": [
              {
                "name": "projectId",
                "value": "",
                "type": "path"
              },
              {
                "name": "environmentId",
                "value": "",
                "type": "path"
              },
              {
                "name": "playerId",
                "value": "",
                "type": "path"
              },
              {
                "name": "playersItemIds",
                "value": "",
                "type": "query"
              },
              {
                "name": "itemIds",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns all inventory items currently held by the player."
        }
      ]
    }
  ],
  "bundled": true
}