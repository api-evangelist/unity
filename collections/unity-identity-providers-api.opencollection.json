{
  "opencollection": "1.0.0",
  "info": {
    "name": "Unity Analytics Allocations Identity Providers API",
    "version": "v1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-api-key",
      "value": "{{x-api-key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Identity Providers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Sign In With External Token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://analytics.services.api.unity.com/v1/authentication/external-token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Authenticates a player using a token from an external identity provider such as Google, Apple, Steam, Facebook, or a custom provider."
        },
        {
          "info": {
            "name": "Link External Identity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://analytics.services.api.unity.com/v1/players/:playerId/link/external-token",
            "params": [
              {
                "name": "playerId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Links an external identity provider to an existing player account."
        },
        {
          "info": {
            "name": "Unlink External Identity",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://analytics.services.api.unity.com/v1/players/:playerId/unlink/external-token",
            "params": [
              {
                "name": "playerId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Removes a linked external identity provider from a player account."
        }
      ]
    }
  ],
  "bundled": true
}